# WiFiT .gitignore

# Documentation policy: README.md is the only tracked documentation file
*.md
!/README.md

# Non-Markdown internal documentation
/NEXT_AGENT_PROMPT.txt
/COMMIT_SUMMARY.txt
/VERIFIED_FEATURES.txt
/upstream.txt
/rebrand_config.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.log

# WiFiT specific
reports/
validation_logs/
.WiFiT/
*.session
*.pcap

# Temporary files
*.tmp
*.temp
.cache/
